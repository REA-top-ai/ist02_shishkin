class NewsAPIError(Exception):
    """Ошибка при работе с NewsAPI."""


class MistralAIError(Exception):
    """Ошибка при работе с Mistral AI."""


def _make_request(endpoint: str, api_key: str, params: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    url = f"{BASE_URL}/{endpoint}"
    final_params: Dict[str, Any] = {"apiKey": api_key}

    if params:
        final_params.update({k: v for k, v in params.items() if v is not None})

    try:
        response = requests.get(url, params=final_params, timeout=10)
        response.raise_for_status()

        data = response.json()

        if isinstance(data, dict) and data.get("status") == "error":
            raise NewsAPIError(f"NewsAPI error: {data.get('code')} - {data.get('message')}")

        return data

    except requests.exceptions.RequestException as e:
        raise NewsAPIError(f"Ошибка при запросе к NewsAPI ({endpoint}): {e}") from e
    except ValueError as e:
        raise NewsAPIError(f"Ошибка при парсинге JSON ({endpoint}): {e}") from e


def get_top_headlines(
    api_key: str,
    q: str = None,
    country: str = None,
    category: str = None,
    sources: str = None,
    page_size: int = None,
    page: int = None,
) -> Dict[str, Any]:
    params = {
        "q": q,
        "country": country,
        "category": category,
        "sources": sources,
        "pageSize": page_size,
        "page": page,
    }
    return _make_request("top-headlines", api_key, params)


def get_everything(
    api_key: str,
    q: str = None,
    q_in_title: str = None,
    sources: str = None,
    domains: str = None,
    exclude_domains: str = None,
    from_param: str = None,
    to: str = None,
    language: str = None,
    sort_by: str = None,
    page_size: int = None,
    page: int = None,
) -> Dict[str, Any]:
    params = {
        "q": q,
        "qInTitle": q_in_title,
        "sources": sources,
        "domains": domains,
        "excludeDomains": exclude_domains,
        "from": from_param,
        "to": to,
        "language": language,
        "sortBy": sort_by,
        "pageSize": page_size,
        "page": page,
    }
    return _make_request("everything", api_key, params)


def get_sources(
    api_key: str,
    category: str = None,
    language: str = None,
    country: str = None,
) -> Dict[str, Any]:
    params = {"category": category, "language": language, "country": country}
    return _make_request("top-headlines/sources", api_key, params)


def get_articles_for_last_day(news_api_key: str, topic: str) -> List[Dict[str, Any]]:
    """
    Получает статьи по заданной теме за последний день.
    
    Args:
        news_api_key: API ключ NewsAPI
        topic: Тема для поиска новостей
    
    Returns:
        Список статей
    """
    end_date = datetime.now()
    start_date = end_date - timedelta(days=1)
    
    from_date = start_date.strftime("%Y-%m-%d")
    to_date = end_date.strftime("%Y-%m-%d")
    
    try:
        articles_data = get_everything(
            api_key=news_api_key,
            q=topic,
            from_param=from_date,
            to=to_date,
            language="ru",  
            sort_by="publishedAt",
            page_size=50  
        )
        
        return articles_data.get("articles", [])
    
    except NewsAPIError as e:
        print(f"Ошибка при получении статей: {e}")
        return []


def generate_annotation_with_mistral(articles: List[Dict[str, Any]], topic: str) -> str:
    """
    Отправляет статьи в Mistral AI и получает аннотацию.
    
    Args:
        articles: Список статей
        topic: Тема новостей
    
    Returns:
        Аннотация на русском языке (250-300 слов)
    """
    if not articles:
        return f"За последний день не найдено новостей по теме '{topic}'."
    
    # Формируем контекст из статей
    articles_context = []
    for i, article in enumerate(articles[:20], 1):  # Ограничиваем 20 статьями
        title = article.get("title", "Без заголовка")
        description = article.get("description", "Описание отсутствует")
        content = article.get("content", "Содержание отсутствует")
        
        articles_context.append(f"""
Статья {i}:
Заголовок: {title}
Описание: {description}
Содержание: {content[:500]}  # Ограничиваем длину контента
---""")
    
    prompt = f"""
Ты - профессиональный аналитик новостей. Проанализируй следующие новости по теме "{topic}" за последние 24 часа.

Новости:
{chr(10).join(articles_context)}

На основе этих новостей составь подробную аннотацию (250-300 слов) на русском языке, которая:
1. Кратко резюмирует основные события, произошедшие за последний день по заданной теме
2. Выделяет ключевые тенденции и важные моменты
3. Даёт оценку общей ситуации
4. Отмечает, какие события были наиболее значимыми

Важно: Аннотация должна быть информативной, объективной и хорошо структурированной. Используй официально-деловой или публицистический стиль.
"""
    
    try:
        # Запрос к Mistral AI API
        response = requests.post(
            "https://api.mistral.ai/v1/chat/completions",
            headers={
                "Authorization": f"Bearer {MISTRAL_API_KEY}",
                "Content-Type": "application/json"
            },
            json={
                "model": "mistral-large-latest",
                "messages": [
                    {
                        "role": "user",
                        "content": prompt
                    }
                ],
                "temperature": 0.3,
                "max_tokens": 1000
            },
            timeout=30
        )
        
        response.raise_for_status()
        result = response.json()
        
        annotation = result.get("choices", [{}])[0].get("message", {}).get("content", "")
        
        if not annotation:
            return "Не удалось получить аннотацию от Mistral AI."
        
        return annotation
    
    except requests.exceptions.RequestException as e:
        raise MistralAIError(f"Ошибка при запросе к Mistral AI: {e}")
    except json.JSONDecodeError as e:
        raise MistralAIError(f"Ошибка при парсинге ответа Mistral AI: {e}")


def save_annotation_to_file(annotation: str, topic: str, filename: str = "annotation.txt") -> str:
    """
    Сохраняет аннотацию в текстовый файл.
    
    Args:
        annotation: Текст аннотации
        topic: Тема новостей
        filename: Имя файла для сохранения (по умолчанию "annotation.txt")
    
    Returns:
        Полный путь к сохранённому файлу
    """
    # Создаём красивый заголовок для файла
    current_time = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    
    file_content = f"""
{'='*80}
АННОТАЦИЯ НОВОСТЕЙ ПО ТЕМЕ: {topic.upper()}
Дата создания: {current_time}
{'='*80}

{annotation}

{'='*80}
Конец аннотации
Создано с использованием NewsAPI и Mistral AI
{'='*80}
"""
    
    try:
        with open(filename, 'w', encoding='utf-8') as file:
            file.write(file_content)
        
        # Получаем абсолютный путь к файлу
        full_path = os.path.abspath(filename)
        print(f"✅ Аннотация успешно сохранена в файл: {full_path}")
        
        return full_path
    
    except IOError as e:
        raise IOError(f"Ошибка при сохранении файла {filename}: {e}")


def analyze_news_topic(topic: str, news_api_key: str, output_filename: str = "annotation.txt") -> str:
    """
    Основная функция: получает новости за последний день по теме, 
    возвращает аннотацию и сохраняет её в файл.
    
    Args:
        topic: Тема для анализа
        news_api_key: API ключ NewsAPI
        output_filename: Имя файла для сохранения аннотации
    
    Returns:
        Текст аннотации
    """
    print(f"📰 Получаем новости по теме '{topic}' за последний день...")
    articles = get_articles_for_last_day(news_api_key, topic)
    
    print(f"📊 Найдено {len(articles)} статей.")
    
    if not articles:
        error_msg = f"За последний день не найдено новостей по теме '{topic}'. Попробуйте другую тему."
        print(f"⚠️ {error_msg}")
        
        # Сохраняем сообщение об ошибке
        save_annotation_to_file(error_msg, topic, output_filename)
        return error_msg
    
    print("🤖 Отправляем данные в Mistral AI для генерации аннотации...")
    annotation = generate_annotation_with_mistral(articles, topic)
    
    # Сохраняем аннотацию 
    save_annotation_to_file(annotation, topic, output_filename)
    
    return annotation


